# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interview_support"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth / Auth.js v5
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"
AUTH_SECRET="your-secret-key-change-in-production"

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"

# WebSocket Server
WS_SERVER_PORT=3001

# S3 / MinIO (ローカル開発)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="interview-support"

# Recall.ai (会議Bot)
RECALL_API_KEY="your-recall-api-key"
RECALL_API_URL="https://api.recall.ai/api/v1"

# SSO - OIDC (Azure AD, Okta, Google Workspace等)
# SSO_OIDC_CLIENT_ID=""
# SSO_OIDC_CLIENT_SECRET=""
# SSO_OIDC_ISSUER=""
# SSO_OIDC_PROVIDER_NAME="SSO (OIDC)"

# SSO - SAML (BoxyHQ SAML Jackson等)
# SSO_SAML_CLIENT_ID=""
# SSO_SAML_CLIENT_SECRET=""
# SSO_SAML_ISSUER=""
# SSO_SAML_PROVIDER_NAME="SSO (SAML)"
